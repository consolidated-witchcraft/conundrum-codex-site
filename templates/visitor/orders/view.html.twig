{% extends 'base/base.html.twig' %}
{% block body %}
    <div class="row">
        <div class="col">
            <nav class="secondary">
                <a href="{{ path('orders.invoice', {'orderReference': order.getOrderReference}) }}">Get Printable Invoice</a>
            </nav>

        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Totals</h2>
            <table class="table shadowed">

                <tbody>
                <tr>
                    <th>Products</th>
                    <td>{{ order.getProductLineTotalPreTaxDecimal|format_currency('GBP') }}</td>
                </tr>
                <tr>
                    <th>Charges</th>
                    <td>{{ order.getChargeLineTotalPreTaxDecimal|format_currency('GBP') }}</td>
                </tr>
                <tr>
                    <th>Taxes</th>
                    <td>{{ order.getTotalTaxDecimal|format_currency('GBP') }}</td>
                </tr>
                </tbody>
                <tfoot>
                <tr>
                    <th>Total</th>
                    <td>
                        <strong>
                            {{ order.getTotalPostTaxDecimal|format_currency('GBP') }}
                        </strong>
                    </td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="row bordered">
        <div class="col">
            <h2>Products</h2>
            <table class="table shadowed">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="hide-sm">SKU</th>
                        <th>Quantity</th>
                        <th class="hide-sm">Unit Price Pre-Tax</th>
                        <th>Total Pre-Tax</th>
                    </tr>
                </thead>
                <tbody>
                    {% for productLine in order.getProductOrderLines %}
                        <tr>
                            <td>
                                {{ productLine.getProductVariant.getProductVariantName }}
                            </td>
                            <td class="hide-sm">
                                {{ productLine.getProductVariant.getSku }}
                            </td>
                            <td>
                                {{ productLine.getQuantity }}
                            </td>
                            <td class="hide-sm">
                                {{ productLine.getProductVariant.getPreTaxPriceDecimal|format_currency('GBP') }}
                            </td>
                            <td>
                                {{ productLine.getTotalDecimal|format_currency('GBP') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>

                        <td></td>
                        <td class="hide-sm"></td>
                        <td class="hide-sm"></td>
                        <th>Total</th>
                        <td>
                            <strong>{{ order.getProductLineTotalPreTaxDecimal|format_currency('GBP') }}</strong>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="col">
            <h2>Charges</h2>
            <table class="table shadowed">
                <thead>
                    <tr>
                        <th>Charge Name</th>
                        <th>Price Pre-Tax</th>
                    </tr>
                </thead>
                <tbody>
                    {% for chargeLine in order.getChargeLines %}
                        <tr>
                            <td>
                                {{ chargeLine.getName }}
                            </td>
                            <td>
                                {{ chargeLine.getPriceDecimal|format_currency('GBP') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total</th>
                        <td>
                            <strong>{{ order.getChargeLineTotalPreTaxDecimal|format_currency('GBP') }}</strong>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="col">
            <h2>Tax</h2>
            <table class="table shadowed">
                <thead>
                <tr>
                    <th>Tax Name</th>
                    <th>Amount</th>
                </tr>
                </thead>
                <tbody>
                {% for taxLine in order.getOrderTaxes %}
                    <tr>
                        <td>
                            {{ taxLine.getTaxRatePublicReference }}
                        </td>
                        <td>
                            {{ taxLine.getAmountDecimal|format_currency('GBP') }}
                        </td>

                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr>
                    <th>Total</th>
                    <td>
                        <strong>{{ order.getTotalTaxDecimal|format_currency('GBP') }}</strong>
                    </td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Payments</h2>
            <table class="table shadowed">
                <thead>
                <tr>
                    <th>Payment Name</th>
                    <th class="hide-sm">Reference</th>
                    <th>Amount</th>
                    <th>Receipt(s)</th>
                </tr>
                </thead>
                    <tbody>
                        {% for payment in order.getOrderPayments %}
                            <tr>
                                <td>
                                    {{ payment.getName }}
                                    <span class="badge {% if payment.getPaymentStatus.isPaid %} badge-success{% endif %}">{{ payment.getPaymentStatus.getName }}</span>

                                </td>
                                <td class="hide-sm">
                                    {{ payment.getPaymentReference }}
                                </td>
                                <td>
                                    {{ payment.getPaymentAmountDecimal|format_currency('GBP') }}
                                </td>

                                <td>
                                    {% if payment.getPaymentReceipts is not empty %}
                                        <ul>
                                            {% for receipt in payment.getPaymentReceipts %}
                                                <li><a href="{{ path(
                                                        'payments.receipt.view',
                                                        {
                                                            'orderReference': order.getOrderReference,
                                                            'paymentReference': payment.getPaymentReference,
                                                            'receiptReference': receipt.getReceiptReference
                                                        }
                                                    ) }}">Get Printable Receipt</a></li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        <em>No Receipts are available.</em>
                                    {% endif %}
                                </td>

                            </tr>
                        {% endfor %}
                    </tbody>
                <tfoot>
            </table>
        </div>
    </div>
{% endblock %}
