{% extends 'base/base.html.twig' %}
{% block body %}
    <div class="row">
        <div class="grid">
            {% for template in templates %}
                <article class="card">
                    <a href="{{ path('app.puzzles.template.show', {'templateSlug': template.getSlug }) }}"><h2 class="card-title">{{ template.getTitle }}</h2></a>

                    <div class="card-body">
                        {{ template.getDescription }}

                    </div>

                    <div class="card-footer">
                        <a href="{{ path('app.puzzles.instance.add', {'templateSlug': template.getSlug}) }}" class="btn btn-primary">Add to Game</a>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
{% endblock %}
{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/cards.css" />
{% endblock %}
