<div id="accountdetails" class="active tab-content">
    <div class="row one-third-two-thirds">
        <div class="col">
            <div class="avatar-wrapper">
                <img class="avatar" src="{{ user.getAvatar ? user.getAvatar.getPathForDerivative('avatar') :  '/dist/images/default-avatar.webp' }}" alt="Your Avatar" loading="lazy" is="lazy-image">
            </div>
        </div>

        <div class="col">
            <div class="user-details">
                <address class="user-contact-details">
                    <label id="userNameLabel" for="username">Name</label>
                    <span id="username" aria-labelledby="userNameLabel">{{ user.userName }}</span>
                    <label id="emailLabel" for="email">Email</label>
                    <span id="email" aria-labelledby="emailLabel">{{ user.email }}</span>
                </address>
                <dl class="account-badges">
                    <dt>Account Type</dt>
                    <dd>
                        <span class="badge badge-info">{{ user.getUserAccountType.getLabel }}</span>
                    </dd>
                    <dt>Profile Visibility</dt>
                    <dd>
                        <span class="badge badge-{{ user.isProfilePublic  ? 'info' : 'success' }}">{{ user.isProfilePublic  ? 'Public' : 'Private' }}</span>
                    </dd>
                    <dt>Cookies Accepted</dt>
                    <dd>
                        <span class="badge badge-info">{{ user.getHasAcceptedCookies  ? 'Yes' : 'No' }}</span>
                    </dd>
                    <dt>Preferred Font Stack</dt>
                    <dd>
                        <span class="badge badge-info">{{ user.getUserPreferences.getPreferredFontStack.getLabel }}</span>
                    </dd>
                </dl>
            </div>

            <nav class="secondary">
                {% if user.isProfilePublic %}
                    <a href="{{ path('app.user.account.view', {'id': user.getId}) }}">View my Public Profile</a>
                {% endif %}
                <a href="{{ path('app.user.account.edit') }}">Change these details</a>
                <a href="{{ path('app.user.account.change-password') }}">Change Password</a>
                <a href="{{ path('app.auth.logout') }}">Logout</a>
            </nav>

        </div>
    </div>
</div>
