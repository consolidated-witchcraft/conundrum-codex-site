<div id="invitations" class="tab-content">
    <div class="row">
        <div class="col">
            {% if campaignInvitations is not empty %}
                <div class="accordion-list" is="accordion-list">
                    {% for invitation in campaignInvitations %}
                        <article class="accordion-entry" id="campaign-invitation-{{ invitation.id }}" is="accordion-entry">
                            <h3 class="accordion-heading">Campaign invitation from: {{ invitation.campaign.gamesMaster.username }}</h3>
                            <div class="accordion-body">
                                <div class="accordion-content">
                                    <dl class="invitation-header">
                                        <dt>Campaign:</dt>
                                        <dd>{{ invitation.campaign.name }}</dd>
                                        <dt>From:</dt>
                                        <dd>{{ invitation.campaign.gamesMaster.email }}</dd>
                                        <dt>Received:</dt>
                                        <dd>{{ invitation.createdAt|date('Y-m-d H:i') }}</dd>
                                        <dt>Message:</dt>
                                        <dd>{{ invitation.invitationMessage }}</dd>
                                        <dt>This invitation will expire at:</dt>
                                        <dd>{{ invitation.expiresAt|date('Y-m-d H:i') }}</dd>
                                    </dl>
                                </div>
                                <div class="accordion-footer">
                                    <nav class="secondary" id="campaign-invitation-{{ invitation.id }}-actions">
                                        <a href="{{ path('app.campaigns.invite.accept', {'invitationCode': invitation.invitationCode}) }}">Accept</a>
                                        <a href="{{ path('app.campaigns.invite.decline', {'invitationCode': invitation.invitationCode}) }}">Decline</a>
                                    </nav>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <em>You have no outstanding invitations.</em>
            {% endif %}
            <p id="redeem-campaign-invitation-link"><a href="{{ path('app.campaigns.invite.redeem') }}">Join a campaign with an invitation code</a></p>
        </div>
    </div>

</div>
