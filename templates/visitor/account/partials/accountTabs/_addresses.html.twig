<div id="addresses" class="tab-content">
    <div class="row">
        <div class="col">
            {% if user.getPostalAddresses is empty %}
                <em>You have not stored any Postal Addresses against your account.</em>
            {% else %}
                <div class="accordion-list" is="accordion-list">
                    {% for postalAddress in user.getPostalAddresses %}
                        {% embed '/visitor/widgets/partials/_accordionEntry.html.twig' with {
                            'entryId': postalAddress.id,
                            'title': postalAddress.label
                        }%}
                            {% block accordionContent %}
                                {% embed 'visitor/postalAddress/partials/_postalAddress.view.html.twig' with {'postalAddress': postalAddress} %}{% endembed %}
                                {% if postalAddress.isDefaultShippingAddress %}
                                    <span class="badge">Default Shipping Address</span>
                                {% endif %}
                                {% if postalAddress.isDefaultBillingAddress %}
                                    <span class="badge">Default Billing Address</span>
                                {% endif %}
                            {% endblock %}
                            {% block accordionFooter %}
                                <nav class="secondary">
                                    <a href="{{ path('app.user.address.edit', {'postalAddressId': postalAddress.getId}) }}">Edit this address</a>
                                    <a href="{{ path('app.user.address.delete', {'postalAddressId': postalAddress.getId}) }}">Delete this address</a>
                                </nav>

                            {% endblock %}
                        {% endembed %}

                    {% endfor %}
                </div>
            {% endif %}
            <nav class="secondary">
                <a href="{{ path('app.user.address.add', {'id': user.getId}) }}">Add a new Address</a>
            </nav>
        </div>
    </div>

</div>
