{% extends 'base/base.html.twig' %}
{% block body %}
    <div class="row one-third-two-thirds">

        <div class="col">

            <div class="avatar-wrapper">
                <img class="avatar" src="{{ user.getAvatar ? user.getAvatar.getPath :  '/dist/images/default-avatar.webp' }}" alt="{{ user.getAvatar ? user.getAvatar.getDescription : 'Default avatar' }}" loading="lazy" is="lazy-image">
            </div>
        </div>
        <div class="col">
            <div class="user-details">
                <address class="user-contact-details">
                    <label id="userNameLabel" for="username">Name</label>
                    <span id="username" aria-labelledby="userNameLabel">{{ user.userName }}</span>
                </address>
            </div>

        </div>

    </div>
    <hr>
    {% if user.getFeats is not empty %}
        <div class="row">
            <div class="col">
                <h2>{{ user.getUserName }}'s Feats</h2>
                <div class="feats grid">
                    {% for feat in user.getFeats %}
                        {% embed 'visitor/account/partials/_feat.view.html.twig' with {'feat': feat} %}{% endembed %}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/tabs.css" />
    <link rel="stylesheet" href="/dist/css/widgets/feats.css" />
{% endblock %}

