{% extends 'base/base.html.twig' %}
{% block body %}
    <div class="tabs-element" is="tabs-element">
        <nav class="tab-headings">
            <a href="#accountdetails" class="active">Account Details</a>
            <a href="#characters">Characters</a>
            <a href="#feats">Feats</a>
            <a href="#games">Games</a>
            <a href="#invitations">Invitations</a>
            {% if feature_enabled('EVENTS_SYSTEM') %}
                <a href="#addresses">Addresses</a>
                <a href="#orders">Orders</a>
            {% endif %}
        </nav>
        <div class="tab-content-container">

            {% embed 'visitor/account/partials/accountTabs/_accountDetails.html.twig' with {'user': user} %}{% endembed %}
            {% embed 'visitor/account/partials/accountTabs/_characters.html.twig' with {'user': user} %}{% endembed %}
            {% embed 'visitor/account/partials/accountTabs/_feats.html.twig' with {'user': user} %}{% endembed %}
            {% embed 'visitor/account/partials/accountTabs/_games.html.twig' with {'user': user} %}{% endembed %}
            {% embed 'visitor/account/partials/accountTabs/_invitations.html.twig' with {'user': user} %}{% endembed %}
            {% if feature_enabled('EVENTS_SYSTEM') %}
                {% embed 'visitor/account/partials/accountTabs/_addresses.html.twig' with {'user': user} %}{% endembed %}
                {% embed 'visitor/account/partials/accountTabs/_orders.html.twig' with {'orders': user.getOrders} %}{% endembed %}
            {% endif %}
        </div>
    </div>
{% endblock %}
{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/tabs.css" />
    <link rel="stylesheet" href="/dist/css/widgets/badges.css" />
    <link rel="stylesheet" href="/dist/css/widgets/feats.css" />
    <link rel="stylesheet" href="/dist/css/widgets/cards.css" />
    <link rel="stylesheet" href="/dist/css/widgets/accordions.css" />
{% endblock %}
