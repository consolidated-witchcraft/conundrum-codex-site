{% extends 'base/base.html.twig' %}
{% set noTitle = true %}
{% block body %}
    <div class="row flush three-quarters-one-quarter hide-sm">
        <div class="col">
            <div class="hero">
                <img src="/dist/images/hero2.webp" alt="A puzzled party of adventurers poring over a scroll" class="hero-backer">
                <h1 class="hero-heading" content="Welcome to the Conundrum Codex">Welcome to the Conundrum Codex</h1>
                <div class="hero-content">
                    <p>The Conundrum Codex is a community-driven site where Online Games-Masters can share interactive puzzles with their players.</p>

                </div>
                <div class="hero-cta">
                    <a href="{{ path('app.auth.register') }}" class="btn btn-danger cta">Get Started</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="decorative-frame">
                <h2 class="fancy">Puzzle Templates</h2>
                <nav class="puzzle-categories lozenges grid">
                    {%  for template in templates %}
                        <a href="{{ path('app.puzzles.template.show', {templateSlug: template.getSlug}) }}">{{ template.getTitle }}</a>
                    {% endfor %}
                </nav>
            </div>

        </div>
    </div>
    <div class="row flush bordered three-quarters-one-quarter">
        <div class="col">
            <p class="drop-cap">{{ siteName }} is designed to help online games-masters of tabletop RPGs set give remote players the full RPG experience, regardless of neurodiversity and cognitive differences.</p>
            <p>We're community driven, and offer many different types of tools that can be customised to meet the needs of your game and setting.</p>
            <p>We also offer interactive puzzles that you can set remotely and allow players to respond to, either individually or collaboratively.</p>
            <p><strong>This site is in early Alpha!</strong> Bugs are to be expected. Please use the <a href="{{ path('app.bugs.report') }}">bugs report</a> system to report them if you find them.</p>
            <p>There's only one available puzzle type at the moment, the Casebook Puzzle.</p>
            <p>Soon to come:
                <ul>
                    <li>Buttons</li>
                    <li>Switches</li>
                    <li>Logic Grids</li>
                    <li>And many more!</li>
                </ul>
            </p>
        </div>
        <div class="col">
            <blockquote is="random-quotation">
            </blockquote>
        </div>

    </div>
{% endblock %}
{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/hero.css" />
    <link rel="stylesheet" href="/dist/css/widgets/randomQuotation.css" />
    <link rel="stylesheet" href="/dist/css/widgets/decorativeFrames.css" />
{% endblock %}

