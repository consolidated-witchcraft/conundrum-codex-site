{% extends 'base/base.html.twig' %}
{% set noTitle = true %}
{% block body %}
    <div class="row flush centered hide-sm">
        <div class="col">
            <div class="hero">
                <img src="/dist/images/heros/hero2.webp" alt="Introduce the Dragon to the World - David Revoy" class="hero-backer" is="lazy-image" loading="lazy">
                <div class="hero-content">
                    <h1 class="hero-heading" content="Welcome to the Conundrum Codex">Welcome to the Conundrum Codex</h1>
                    <div class="hero-body">
                        <p>The Conundrum Codex is a community-driven site where Online Games-Masters can share interactive puzzles with their players.</p>

                    </div>
                    <div class="hero-cta">
                        <a href="{{ path('app.auth.register') }}" class="btn btn-danger cta">Get Started</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="decorative-frame">
                <h2 class="frame-title">What is {{ siteName }}?</h2>
                <p>{{ siteName }} is designed to help online games-masters of tabletop RPGs set give remote players the full RPG experience, regardless of neurodiversity and cognitive differences.</p>
                <p>We're community driven, and offer many different types of tools that can be customised to meet the needs of your game and setting.</p>
                <p>We also offer interactive puzzles that you can set remotely and allow players to respond to, either individually or collaboratively.</p>
                <p><strong>This site is in early Alpha!</strong> Bugs are to be expected. Please use the <a href="{{ path('app.bugs.report') }}">bugs report</a> system to report them if you find them.</p>
                <img is="lazy-image" loading="lazy" src="/dist/images/illustrations/resized/for_Huion_by-David-Revoy_medium.webp" alt="For Huion - David Revoy" class="frame-watermark">
            </div>
        </div>
        <div class="col">
            <div class="decorative-frame">
                <h2 class="frame-title">Features</h2>
                <ul class="stars">
                    <li><strong>Worldbooks</strong> - Create custom Wikis for your worlds complete with people, locations, factions and history.</li>
                    <li><strong>Puzzles</strong> - Create customisable puzzles you can share with your players</li>
                    <li><strong>Feats</strong> - Award your players with playful badges when they do something particularly cunning... or foolhardy.</li>
                    <li><strong>Events</strong> - Generate digital tickets for your events and sell them online!</li>
                    <li>And many more to come!</li>
                </ul>
                <img is="lazy-image" loading="lazy" src="/dist/images/illustrations/resized/blue-crystal_medium.webp" alt="Blue Crystal - David Revoy" class="frame-watermark">
            </div>
        </div>
        <div class="col">
            <div class="decorative-frame">
                <h2 class="frame-title">Puzzle Templates</h2>
                <nav class="puzzle-categories grid lozenges">
                    {%  for template in templates %}
                        <a class="btn btn-secondary" href="{{ path('app.puzzles.template.show', {templateSlug: template.getSlug}) }}">{{ template.getTitle }}</a>
                    {% endfor %}
                </nav>
                <img is="lazy-image" loading="lazy" src="/dist/images/illustrations/resized/new-skill_medium.webp" alt="Warrior by David Revoy" class="frame-watermark">
            </div>
        </div>
    </div>
{% endblock %}
{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/hero.css" />
    <link rel="stylesheet" href="/dist/css/widgets/randomQuotation.css" />
    <link rel="stylesheet" href="/dist/css/widgets/decorativeFrames.css" />
{% endblock %}

