{% extends 'base/base.html.twig' %}
{% block body %}
    <div class="row">
        <div class="col">
            <h2>Table</h2>
            <table>
                <thead>
                    <tr>
                        <th>Heading 1</th>
                        <th>Heading 2</th>
                        <th>Heading 3</th>
                        <th>Heading 4</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Cell 1</td>
                        <td>Cell 2</td>
                        <td>Cell 3</td>
                        <td>Cell 4</td>
                    </tr>
                    <tr>
                        <td>Cell 5</td>
                        <td>Cell 6</td>
                        <td>Cell 7</td>
                        <td>Cell 8</td>
                    </tr>
                <tr>
                    <td>Cell 9</td>
                    <td>Cell 10</td>
                    <td>Cell 11</td>
                    <td>Cell 12</td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="col">
            <h2>Tabs</h2>
            <div class="tabs-element" is="tabs-element">
                <nav class="tab-headings">
                    <a href="#person" class="active">People</a>
                    <a href="#object">Objects</a>
                    <a href="#location">Locations</a>
                    <a href="#misc">Misc</a>
                </nav>
                <div class="tab-content-container">
                    <div id="person" class="active tab-content">
                        People
                    </div>
                    <div id="object" class="tab-content">
                        Objects
                    </div>
                    <div id="location" class="tab-content">
                        Locations
                    </div>

                    <div id="misc" class="tab-content">
                        Misc
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Accordion</h2>
            <div class="accordion-list" is="accordion-list">

                {% embed '/visitor/widgets/partials/_accordionEntry.html.twig' with {
                    'entryId': 'item-1',
                    'title': 'Entry 1'
                }%}
                    {% block accordionContent %}
                        Yo yo, this is accordion content.
                    {% endblock %}
                    {% block accordionFooter %}
                        <strong>I'm in the footer.</strong>
                    {% endblock %}
                {% endembed %}

                {% embed '/visitor/widgets/partials/_accordionEntry.html.twig' with {
                    'entryId': 'item-2',
                    'title': 'Entry 2'
                }%}
                    {% block accordionContent %}
                        Content Two
                    {% endblock %}
                {% endembed %}
                {% embed '/visitor/widgets/partials/_accordionEntry.html.twig' with {
                    'entryId': 'item-3',
                    'title': 'Entry 3'
                }%}
                    {% block accordionContent %}
                        Content Three
                    {% endblock %}
                {% endembed %}
                {% embed '/visitor/widgets/partials/_accordionEntry.html.twig' with {
                    'entryId': 'item-4',
                    'title': 'Entry 4'
                }%}
                    {% block accordionContent %}
                        Content Four
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
        <div class="col">
            <h2>Badges</h2>
            <ul class="badge-list">
                <li class="badge badge-primary">Primary Badge</li>
                <li class="badge badge-secondary">Secondary Badge</li>
                <li class="badge badge-info">Info Badge</li>
                <li class="badge badge-success">Success Badge</li>
                <li class="badge badge-warning">Warning Badge</li>
                <li class="badge badge-danger">Danger Badge</li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Feats</h2>
            <div class="feats grid">
                {% for feat in feats %}
                    <aside class="feat">
                        {% embed 'visitor/account/partials/_featIcon.html.twig' with {'feat' : feat} %}{% endembed %}
                        <div class="feat-legend">
                            <h3 class="feat-title">{{ feat.getLabel }}</h3>
                            <span class="feat-description">{{ feat.getDescription }}</span>
                        </div>
                    </aside>
                {% endfor %}
            </div>

        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Cards</h2>
            <div class="grid">
                <article class="card">
                    <h2 class="card-title" content="Card with Hero">Card with Hero</h2>
                    <img class="card-hero" src="/uploads/arec-6973f41a7e42a.jpg" alt="Dummy Hero Image">
                    <div class="card-body">
                        <p>Card body goes here</p>
                    </div>
                    <span class="card-spacer"></span>
                    <div class="card-footer">
                        <a href="" class="btn btn-primary">Footer Button</a>
                    </div>
                </article>
                <article class="card">
                    <h2 class="card-title" content="Card without Hero">Card without Hero</h2>

                    <div class="card-body">
                        <p>Card body goes here</p>
                    </div>

                    <div class="card-footer">
                        <a href="" class="btn btn-primary">Footer Button</a>
                    </div>
                </article>
            </div>

        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Test Wiki Editor</h2>
            <div is="wiki-editor"></div>
            <template id="wikieditor-widget-template">
                <link rel="stylesheet" href="/dist/css/widgets/wikieditor.css" />
                <div class="wikieditor-widget">
                    <nav class="wiki-editor-toolbar">
                        <button class="wikieditor-toolbar-button bold" data-action="bold">
                            B
                        </button>
                        <button class="wikieditor-toolbar-button italic" data-action="italic">
                            I
                        </button>
                        <button class="wikieditor-toolbar-button unordered-list" data-action="unordered-list">
                            UL
                        </button>
                        <button class="wikieditor-toolbar-button ordered-list" data-action="ordered-list">
                            OL
                        </button>
                        <button class="wikieditor-toolbar-button quote" data-action="quote">
                            Quote
                        </button>
                        <button class="wikieditor-toolbar-button wiki-link" data-action="wiki-link">
                            Link
                        </button>
                        <button class="wikieditor-mode">MODE</button>
                    </nav>
                    <textarea name="wikieditor-input" class="wikieditor-input"aria-label="Raw Markdown"></textarea>
                    <div class="wikieditor-gui-surface" data-targetinput="wikieditorinput" contenteditable="true" aria-multiline="true" role="textbox" aria-label="GUI Input"></div>
                </div>
            </template>
        </div>
    </div>
{% endblock %}
{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/tables.css" />
    <link rel="stylesheet" href="/dist/css/widgets/tabs.css" />
    <link rel="stylesheet" href="/dist/css/widgets/accordions.css" />
    <link rel="stylesheet" href="/dist/css/widgets/badges.css" />
    <link rel="stylesheet" href="/dist/css/widgets/feats.css" />
    <link rel="stylesheet" href="/dist/css/widgets/cards.css" />

{% endblock %}
