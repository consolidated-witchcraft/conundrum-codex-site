{% extends 'base/base.html.twig' %}
{% block body %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col">
            <ol class="step-list">
                <li class="">
                    Choose Tickets
                </li>
                <li class="active">
                    Delivery Information
                </li>
                <li>
                    Review your Order
                </li>
                <li>
                    Pay
                </li>
            </ol>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <h2>Receipt Email</h2>
            {{ form_widget(form.receiptEmail) }}
            {{ form_help(form.receiptEmail) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.deliveryAddress) }}
        </div>
        <div class="col">
            {{ form_row(form.billingAddress) }}
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}

