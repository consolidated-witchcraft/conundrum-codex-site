<nav class="secondary hide-sm">
    {% for letter,label in generate_alphabet() %}
        {% if casebook.getSubjectsByTypeHandleAndInitial(subjectType, letter) is not empty %}
            <a href="#{{ subjectType }}_{{ letter }}">{{ label }}</a>

        {% else %}
            <span class="emptyLetter">{{ label }}</span>
        {% endif %}
    {% endfor %}
</nav>
{% if casebook.getSubjectsByTypeHandle(subjectType) is  empty %}

    <p>No items of this type have been revealed</p>
{% else %}
    {% for letter,label in generate_alphabet() %}
        {% if casebook.getSubjectsByTypeHandleAndInitial(subjectType, letter) is not empty %}
            <h2 class="drop-cap sm nofloat" id="{{ subjectType }}_{{ letter }}">{{ label }}</h2><br/>
            {% for subject in casebook.getSubjectsByTypeHandleAndInitial(subjectType, letter) %}
                {% embed 'visitor/puzzleInstances/casebook/subjects/partials/_subject.view.html.twig' with {'subject': subject, 'subjectType': subjectType, 'letter': letter} %}{% endembed %}
            {% endfor %}
        {% endif %}
    {% endfor %}
{% endif %}
