{% extends 'base/base.html.twig' %}
{% block body %}
    <div class="row bordered">
        <div class="col">
            <div class="card">
                <h2 class="card-title" content="Worlds I Created">Worlds I Created</h2>
                <img class="card-hero" src="/dist/images/converted/illustrations/environments-15-ishtar-dragons.webp" alt="Sintel Concept Art - David Revoy - CC 4" loading="lazy" is="lazy-image">
                <div class="card-body">
                    {% if user.getWorldsCreated is not empty %}
                        <div class="accordion-list" is="accordion-list">
                            {% for world in user.getWorldsCreated %}
                                <article class="accordion-entry" id="world-{{ world.id }}" is="accordion-entry" data-open="false">
                                    <h3 class="accordion-heading">{{ world.getName }}</h3>
                                    <div class="accordion-body">
                                        <div class="accordion-content">
                                            {{ world.getDescription }}
                                            <nav class="secondary">
                                                {% if not world.isFullyConfigured %}
                                                    <a class="btn btn-primary" href="{{ path('app.worlds.configure', {'worldSlug': world.getSlug}) }}">Configure World</a>
                                                {% endif %}
                                            </nav>
                                        </div>

                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% else %}
                        <em>It looks like you haven't created any worlds yet. Why not give it a go?</em>
                    {% endif %}
                </div>

                <div class="card-footer">
                    <a class="btn btn-primary" href="{{ path('app.worlds.create') }}">Create a World</a>
                </div>
            </div>

        </div>
        <div class="col">
            <div class="card">
                <img class="card-hero" src="/dist/images/converted/illustrations/new-skill.webp" alt="Blue Crystal - David Revoy - CC 4" loading="lazy" is="lazy-image">
                <h2 class="card-title" content="Worlds I'm Playing In">Worlds I'm Playing In</h2>
                <div class="card-body">
                    {% if user.getWorldsPlayed is not empty %}
                    {% else %}
                        <em>It looks like you're not playing in any worlds yet.</em>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
{% endblock %}

{% block footerStyles %}
    <link rel="stylesheet" href="/dist/css/widgets/cards.css" />
    <link rel="stylesheet" href="/dist/css/widgets/accordions.css" />

{% endblock %}

