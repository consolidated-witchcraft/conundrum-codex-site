<button id="user-nav-toggle" is="nav-toggle" class="nav-toggle user-nav-toggle unstyle" data-target="user-nav" data-open="false">Show User Nav</button>
<nav class="mobile-nav" id="user-nav">

    {% if app.user %}
        <span class="user-greeting">Logged in as <a href="{{ path('app.user.account') }}">{{ app.user.userName }}</a></span>
    {% else %}
        <span class="user-greeting">Not logged in</span>
    {% endif %}
    <ul class="user-menu" aria-label="User Account Navigation">
        {% for navItem in userNav %}
            {% if navItem.getChildren is empty %}
                <li>
                    {% embed 'base/partials/menus/_navLink.html.twig' with {'navItem': navItem}%}{% endembed %}
                </li>
            {% else %}
                <li class="has-submenu">
                    <a is="submenu-trigger" data-targetsubmenu="{{ navItem.handle }}-submenu" class="nav-item submenu-trigger{% if navItem.isActiveTrail %} active-trail{% endif %}">{{ navItem.label }}</a>
                    <ul class="submenu" id="{{ navItem.handle }}-submenu">
                        {% for child in navItem.children %}
                            <li>
                                {% embed 'base/partials/menus/_navLink.html.twig' with {'navItem': child}%}{% endembed %}
                            </li>
                        {% endfor %}
                    </ul>
                </li>
            {% endif %}
        {% endfor %}
    </ul>

</nav>
