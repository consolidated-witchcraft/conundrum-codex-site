{% extends '/admin/base/admin-base.html.twig' %}
{% block body %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col">
            <h2>Avatar</h2>
            <div class="avatar-wrapper">
                <img class="avatar" src="{{ user.getAvatar ? user.getAvatar.getPath : '/dist/images/default-avatar.webp' }}" alt="Your Avatar">
            </div>
            {{ form_row(form.avatar) }}
        </div>
        <div class="col">
            <h2>
                Basic Details
            </h2>
            {{ form_row(form.email) }}
            {{ form_row(form.username) }}
            {{ form_row(form.plainPassword) }}
        </div>
        <div class="col">
            <h2>
                Roles
            </h2>
            {{ form_row(form.roles) }}
            <h2>
                Account Type
            </h2>
            {{ form_row(form.userAccountType) }}
            <h2>
                Games
            </h2>
            <ul>
                {% for game in user.getGames %}
                    <li>{{ game.getName }}</li>
                {% endfor %}
            </ul>

            <h2>Preferences</h2>
            {{ form_row(form.acceptedCookies) }}
            {{ form_row(form.profilePublic) }}

            <h2>
                Feats
            </h2>
            {{ form_row(form.feats) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.submit)}}
        </div>
    </div>
    {{ form_end(form) }}

{% endblock %}
