{% extends '/eventManager/base/event-manager-base.html.twig' %}
{% block body %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col">
            <div class="panel">
                <div class="panel-content">
                    {{ form_row(form.name) }}
                    {{ form_row(form.handle) }}
                    {{ form_row(form.organisationLogo) }}
                    {{ form_row(form.managers) }}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="panel">
                <div class="panel-content">
                    {{ form_row(form.postalAddress) }}
                </div>
            </div>

        </div>
        <div class="col">
            <div class="panel">
                <div class="panel-content">
                    {{ form_row(form.invoiceAddress) }}
                </div>
            </div>

        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
