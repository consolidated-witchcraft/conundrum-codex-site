<h2>Event Summary</h2>
<table class="table">
    <tbody>
        <tr>
            <th>Title</th>
            <td>
                <strong>{{ event.getTitle }}</strong>
                <em>{{ event.getEventSlug }}</em>
            </td>
        </tr>
        <tr>
            <th>Location</th>
            <td>
                {% embed '/visitor/postalAddress/partials/_postalAddress.view.html.twig' with {'postalAddress': event.getLocation, 'singleLine': true} %}{% endembed %}
            </td>
        </tr>
        <tr>
            <th>Start Date</th>
            <td>
                {{ friendly_date(event.getStartDate) }}
            </td>
        </tr>
        <tr>
            <th>End Date</th>
            <td>
                {{ friendly_date(event.getEndDate) }}
            </td>

        </tr>
    </tbody>
</table>
