

{# templates/form/custom_types.html.twig #}
{% block die_roll_row %}
<div class="form-group">
    <div class="die-roll-field">
        {{ form_label(form) }}
        {{ form_help(form) }}
        <table class="table">
            <tbody>
                <tr>
                    <th>Number of Die</th>
                </tr>
                <tr>
                    <td>
                        {{ form_widget(form.x) }}
                        {{ form_help(form.x) }}
                        {{ form_errors(form.x) }}
                    </td>
                </tr>
                <tr>
                    <th>Die Sides</th>
                </tr>
                <tr>

                    <td>
                        {{ form_widget(form.d) }}
                        {{ form_help(form.d) }}
                        {{ form_errors(form.d) }}
                    </td>
                </tr>
                <tr>
                    <th>Plus</th>
                </tr>
                <tr>

                    <td>
                        {{ form_widget(form.p) }}
                        {{ form_help(form.p) }}
                        {{ form_errors(form.p) }}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% endblock %}


{% block clue_row %}
    <div {{ block('attributes') }}>
        <div class="title">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_help(form.title) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="body">
            {{ form_label(form.body) }}
            {{ form_widget(form.body) }}
            {{ form_help(form.body) }}
            {{ form_errors(form.body) }}
        </div>
        <div class="type">
            {{ form_label(form.type) }}
            {{ form_widget(form.type) }}
            {{ form_help(form.type) }}
            {{ form_errors(form.type) }}
        </div>
    </div>
{% endblock %}
{% block postal_address_row %}
    {{ form_widget(form.id) }}
    <div class="address-form-element">
        <strong>{{ form_label(form) }}</strong>
        <div class="label">
            {{ form_label(form.label) }}
            {{ form_widget(form.label) }}
            {{ form_help(form.label) }}
            {{ form_errors(form.label) }}
        </div>
        <address>
            <div class="addressLineOne">
                {{ form_label(form.addressLineOne) }}
                {{ form_widget(form.addressLineOne) }}
                {{ form_help(form.addressLineOne) }}
                {{ form_errors(form.addressLineOne) }}
            </div>
            <div class="addressLineTwo">
                {{ form_label(form.addressLineTwo) }}
                {{ form_widget(form.addressLineTwo) }}
                {{ form_help(form.addressLineTwo) }}
                {{ form_errors(form.addressLineTwo) }}
            </div>
            <div class="townCity">
                {{ form_label(form.townCity) }}
                {{ form_widget(form.townCity) }}
                {{ form_help(form.townCity) }}
                {{ form_errors(form.townCity) }}
            </div>

            <div class="countyProvince">
                {{ form_label(form.countyProvince) }}
                {{ form_widget(form.countyProvince) }}
                {{ form_help(form.countyProvince) }}
                {{ form_errors(form.countyProvince) }}
            </div>

            <div class="countryCode">
                {{ form_label(form.countryCode) }}
                {{ form_widget(form.countryCode) }}
                {{ form_help(form.countryCode) }}
                {{ form_errors(form.countryCode) }}
            </div>

            <div class="postalZip">
                {{ form_label(form.postalZip) }}
                {{ form_widget(form.postalZip) }}
                {{ form_help(form.postalZip) }}
                {{ form_errors(form.postalZip) }}
            </div>
        </address>
        <div class="defaults">
            {{ form_row(form.isDefaultBillingAddress) }}
            {{ form_row(form.isDefaultShippingAddress) }}
        </div>
    </div>


{% endblock %}

{% block user_cart_line_row %}
    <dl class="cart-product-line-preview" is="cartline-preview">
        <dt class="name">Name</dt>
        <dd class="name">NAME</dd>


        <dt class="quantity">Quantity</dt>
        <dd class="quantity">{{ form_widget(form.quantity)}}</dd>

        <dt class="pricePerUnit">Price Per Unit (exc. Tax)</dt>
        <dd class="pricePerUnit">PRICEPERUNIT</dd>
        <dt class="line-total">Total (exc. Tax)</dt>
        <dd class="line-total">LINETOTAL</dd>
    </dl>

{% endblock %}
{% block ticket_type_purchase_row%}
    <div class="ticket-type-purchase-row">
        <div class="name">
            {{ form_label(form) }}

        </div>
        <div class="dates">{{ form_help(form) }}</div>
        <div class="quantity">
            {{ form_label(form.quantity) }}
            {{ form_widget(form.quantity) }}
            {{ form_help(form.quantity) }}
        </div>
        <div class="format">
            {{ form_label(form.selectedFormatSlug) }}
            {{ form_widget(form.selectedFormatSlug) }}
            <div class="format-help">
                {{ form_help(form.selectedFormatSlug) }}
            </div>

        </div>
    </div>
{% endblock %}

{% block sliding_switch_row %}
    <div class="sliding-switch-wrapper {% if required %} required{% endif %}">
    {% if required %}<span class="checkbox-required-indicator">*</span>{% endif %}
        <label>
            <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}/>
            <span class="label-text">{{- block('form_label_content') -}}</span>
            <div class="status-switch"
                 data-unchecked="Disabled"
                 data-checked="Enabled">

            </div>
        </label>
    </div>
{% endblock %}
