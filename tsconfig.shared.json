{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "rootDir": "shared",
        "outDir": "public/shared"
    },
    "include": [
        "shared/**/*"
    ],
    "exclude": [
        "node_modules",
        "public/dist",
        "public/contrib",
        "public/types"
    ]
}
